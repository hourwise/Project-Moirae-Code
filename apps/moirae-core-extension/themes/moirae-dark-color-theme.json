{
  "$schema": "vscode://schemas/color-theme",
  "name": "Moirae Night",
  "type": "dark",
  "colors": {
    "editor.background": "#101421",
    "editor.foreground": "#E7ECF7",
    "sideBar.background": "#151B2B",
    "sideBar.foreground": "#C5D0E8",
    "activityBar.background": "#0B0F1A",
    "activityBar.foreground": "#8FE3CF",
    "activityBar.inactiveForeground": "#69758F",
    "statusBar.background": "#0B0F1A",
    "statusBar.foreground": "#8FE3CF",
    "titleBar.activeBackground": "#101421",
    "focusBorder": "#8FE3CF",
    "button.background": "#2D7A72",
    "button.hoverBackground": "#3B958A",
    "textLink.foreground": "#8FE3CF",
    "list.activeSelectionBackground": "#24364A",
    "list.activeSelectionForeground": "#FFFFFF",
    "panel.border": "#26324A",
    "terminal.background": "#0B0F1A",
    "terminal.foreground": "#D6E2F0"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#71809B" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#C8A7FF" } },
    { "scope": ["string"], "settings": { "foreground": "#9DD9B9" } },
    { "scope": ["constant", "number"], "settings": { "foreground": "#F6C177" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#82B1FF" } }
  ],
  "semanticHighlighting": true
}
